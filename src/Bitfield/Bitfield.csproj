<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Bitfield</RootNamespace>
    <AssemblyName>Bitfield</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <Product>Bitfield Torrent</Product>
    <Company>szabolevi98</Company>
    <Copyright>Copyright (c) 2026 szabolevi98</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bitfield.Core\Bitfield.Core.csproj" />
    <EmbeddedResource Include="Resources\app.ico" LogicalName="Bitfield.app.ico" />
  </ItemGroup>

</Project>
